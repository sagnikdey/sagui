{
  "name": "sagui",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm --filter @sagui/tokens --filter @sagui/ui build",
    "dev:storybook": "pnpm --filter @sagui/storybook dev",
    "dev:docs": "pnpm --filter @sagui/docs dev",
    "build:storybook": "pnpm build && pnpm --filter @sagui/storybook build",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "typescript": "^5.6.0"
  }
}
